# Copy to .env to change defaults.

# Interface and port the server listens on. 127.0.0.1 = this computer only.
BIND_ADDRESS=127.0.0.1
PORT=4040

# Optional fixed master key (for the Parse REST API / dashboard). Random per start if empty.
MASTER_KEY=

# URL players reach the server at (used in links the server generates).
PUBLIC_SERVER_URL=http://127.0.0.1:4040/parse
